{
  "modName": "AdjustableSurvivalModeDamage",
  "displayName": "Настройка урона в выживании",
  "minMcmVersion": 2,
  "pluginRequirements": [
    "AdjustableSurvivalModeDamage.esl"
  ],
  "content": [
    {
      "text": "<p align='center'><font size='30'>Настройка урона в режиме выживания</font></p>",
      "html": true,
      "type": "text"
    },
    {
      "id": "fIncoming:Main",
      "text": "Множитель получаемого урона:",
      "type": "slider",
      "help": "Ползунок задаёт урон, наносимый вам. Значение Lunar по умолчанию - 1.3.",
      "valueOptions": {
        "min": 0.1,
        "max": 4,
        "step": 0.1,
        "sourceType": "ModSettingFloat"
      },
      "action": {
        "type": "CallFunction",
        "form": "AdjustableSurvivalModeDamage.esl|01000F99",
        "function": "ModifyDamageMultiplier",
        "params": [ 
			true, 
			"{value}",
			false
		]
      }
    },
	{
      "id": "fOutgoing:Main",
      "text": "Множитель наносимого урона:",
      "type": "slider",
      "help": "Ползунок задаёт урон, который наносите вы. Значение Lunar по умолчанию - 1.",
      "valueOptions": {
        "min": 0.1,
        "max": 4,
        "step": 0.1,
        "sourceType": "ModSettingFloat"
      },
      "action": {
        "type": "CallFunction",
        "form": "AdjustableSurvivalModeDamage.esl|01000F99",
        "function": "ModifyDamageMultiplier",
        "params": [ 
			false, 
			"{value}",
			false
		]
      }
    }
  ]
}