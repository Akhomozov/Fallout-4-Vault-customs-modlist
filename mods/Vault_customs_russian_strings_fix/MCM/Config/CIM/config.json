{
   "modName":"CIM",
   "displayName":"Контроль инвентаря спутника",
   "minMcmVersion":2,
   "pluginRequirements": ["CIM.esl"],
   "content":[
      { "type":"spacer", "numLines":2 },
      {
         "text":"<p align='center'><font size='50'>Companion Inventory Monitor<br/><font size='10'>(v1.0)</font></font></p>",
         "html":true,
         "type":"text"
      },
      { "type":"spacer", "numLines":2 },
      {
         "text":"<p align='center'><font size='30'>Следит за инвентарём спутника, фильтрует и ограничивает его</font></p>",
         "html":true,
         "type":"text"
      }
   ],
   "pages":[
      {
         "pageDisplayName":"Основное",
         "content":[
            {
               "text": "<p align='center'><b><font size='24'>Companion Inventory Monitor <font size='10'>(v1.0)</font></font></b><br/><font size='14'>Следит за инвентарём спутника, фильтрует и ограничивает его</font></p>",
               "html": true,
               "type": "text"
            },
            { "type":"spacer" },
            {
               "text": "Основное",
               "type": "section"
            },
            {
               "id":"bEnabled:Main",
               "text":"Слежение включено",
               "type":"switcher",
               "help":"Следить ли за изменениями в инвентаре спутника",
               "valueOptions":{
                  "sourceType":"ModSettingBool"
               }
            },
            { "type":"spacer" },
            {
               "text": "Спутники",
               "type": "section"
            },
            {
               "id":"iRefreshTimeInSeconds:Main",
               "text":"Период обновления списка спутников, в секундах",
               "type":"slider",
               "help":"Как часто обновляется список ваших спутников (ставьте меньше, если часто их меняете)",
               "valueOptions":{
                  "min": 1,
                  "max": 600,
                  "step": 5,
                  "sourceType":"ModSettingInt"
               }
            }
         ]
      },
      {
         "pageDisplayName":"Фильтры",
