                  "type": "CallFunction",
                  "form": "CIM.esl|01000001",
                  "script": "CIM_Quest",
                  "function": "CheckRunning"
               }
            },
            {
               "text": "Принудительный запуск",
               "type": "button",
               "help": "Принудительно запускает мод",
