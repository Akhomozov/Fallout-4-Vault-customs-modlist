        }
      },
      {
        "id": "bIsActiveOnlyIfPlayerInCombat:Settings",
        "text": "Только когда игрок в бою",
        "type": "switcher",
        "valueOptions": {
          "sourceType": "ModSettingBool"
        },
        "action": {
            "type": "CallExternalFunction",
            "plugin": "DisableCompanionCollision",
